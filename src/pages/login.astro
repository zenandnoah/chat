---
import Layout from "../layouts/Main.astro"
---
<Layout><div class="flex justify-center items-center h-screen">
<form class="flex flex-col w-76" action="/api/auth/login" method="POST">
  <input type="text" placeholder="email" class="input my-2" name="email"/>
  <input type="password" placeholder="password" class="input" name="password" />
  <button type="submit" class="btn my-2">submit</button>
</form>
</div>
</Layout>
